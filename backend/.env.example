# =============================================================================
# APPLICATION
# =============================================================================

# Node environment: development | test | production
NODE_ENV=development

# Port on which the Express server will listen
PORT=4000

# Public base URL of the API (used for constructing absolute URLs, e.g. image links)
API_BASE_URL=http://localhost:4000

# =============================================================================
# DATABASE (PostgreSQL)
# =============================================================================

# Hostname or IP address of the PostgreSQL server
DB_HOST=127.0.0.1

# PostgreSQL port (default: 5432)
DB_PORT=5432

# Name of the application database
DB_NAME=ecommerce_dev

# PostgreSQL username
DB_USER=postgres

# PostgreSQL password
DB_PASSWORD=postgres

# Set to "true" to enable SSL for the database connection (recommended in production)
DB_SSL=false

# =============================================================================
# TEST DATABASE (PostgreSQL)
# Used by the test environment defined in knexfile.js
# =============================================================================

TEST_DB_HOST=127.0.0.1
TEST_DB_PORT=5432
TEST_DB_NAME=ecommerce_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres

# =============================================================================
# AUTHENTICATION / JWT
# =============================================================================

# Secret key used to sign access tokens — keep this long, random, and private
JWT_SECRET=change_me_to_a_long_random_secret

# Access token lifetime expressed as a zeit/ms string (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=1h

# Secret key used to sign refresh tokens — must differ from JWT_SECRET
JWT_REFRESH_SECRET=change_me_to_another_long_random_secret

# Refresh token lifetime
JWT_REFRESH_EXPIRES_IN=7d

# =============================================================================
# ELASTICSEARCH
# =============================================================================

# Full URL of the Elasticsearch node (used by the search module)
ELASTICSEARCH_URL=http://localhost:9200

# Elasticsearch index name for product documents
ELASTICSEARCH_INDEX=products

# Optional: Elasticsearch username (leave blank if security is disabled)
ELASTICSEARCH_USERNAME=

# Optional: Elasticsearch password (leave blank if security is disabled)
ELASTICSEARCH_PASSWORD=

# =============================================================================
# PAYMENT GATEWAY
# =============================================================================

# Adapter to use for payment processing: mock | stripe | razorpay
PAYMENT_ADAPTER=mock

# Stripe publishable key (required when PAYMENT_ADAPTER=stripe)
STRIPE_PUBLISHABLE_KEY=

# Stripe secret key (required when PAYMENT_ADAPTER=stripe)
STRIPE_SECRET_KEY=

# Stripe webhook signing secret (required when PAYMENT_ADAPTER=stripe)
STRIPE_WEBHOOK_SECRET=

# Razorpay key ID (required when PAYMENT_ADAPTER=razorpay)
RAZORPAY_KEY_ID=

# Razorpay key secret (required when PAYMENT_ADAPTER=razorpay)
RAZORPAY_KEY_SECRET=

# =============================================================================
# RATE LIMITING
# =============================================================================

# Maximum number of requests per window per IP for general endpoints
RATE_LIMIT_MAX=100

# Window duration in milliseconds (default: 15 minutes)
RATE_LIMIT_WINDOW_MS=900000

# Maximum number of requests per window for auth endpoints (stricter)
RATE_LIMIT_AUTH_MAX=20

# =============================================================================
# LOGGING
# =============================================================================

# Log level: error | warn | info | http | verbose | debug | silly
LOG_LEVEL=info

# Set to "true" to pretty-print logs (useful in development)
LOG_PRETTY=true

# =============================================================================
# CORS
# =============================================================================

# Comma-separated list of allowed origins for CORS
# Example: http://localhost:3000,https://myapp.com
CORS_ORIGINS=http://localhost:3000

# =============================================================================
# EMAIL (used for password reset and order notifications)
# =============================================================================

# SMTP host
SMTP_HOST=smtp.mailtrap.io

# SMTP port (587 for STARTTLS, 465 for SSL)
SMTP_PORT=587

# SMTP username
SMTP_USER=

# SMTP password
SMTP_PASS=

# "From" address shown in outgoing emails
EMAIL_FROM=noreply@ecommerce.local

# =============================================================================
# FRONTEND
# =============================================================================

# Public URL of the frontend application (used in email links, etc.)
FRONTEND_URL=http://localhost:3000
